{
  "name": "systemslab-comments-server",
  "version": "0.1.0",
  "private": true,
  "description": "Systemslab.ai comments API: inline comment threads for Practice, Lifecycle and Form",
  "main": "dist/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "NODE_ENV=development ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && node scripts/copy-assets.js",
    "start": "node dist/database/migrate.js && node dist/server.js",
    "migrate": "node dist/database/migrate.js",
    "test": "jest --runInBand",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
